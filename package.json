{
  "name": "@crack/dsh-client-ui-skin-cottage",
  "description": "Pastoral cottage skin for the DSH web GUI: full-screen wallpaper with frosted-glass panels",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsdown",
    "watch": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "license": "MIT",
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "skin.json"
  ],
  "devDependencies": {
    "@types/node": "^26.2.0",
    "lightningcss": "^1.33.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  }
}
